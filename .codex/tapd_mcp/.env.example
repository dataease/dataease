TAPD_WORKSPACE_ID="40899682"
TAPD_CURRENT_USER="your TAPD username"
TAPD_API_TOKEN="your personal token"
TAPD_MCP_ENTRY="/absolute/path/to/tapd-mcp/dist/index.js"
NODE_BIN="node"

# auto 根据扩展名或 shebang 判断；也可指定 node / python
MCP_RUNTIME="auto"
# Python 入口请使用安装该 MCP 的虚拟环境解释器
PYTHON_BIN="python3"

# Python mcp-server-tapd：入口填写虚拟环境 bin/mcp-server-tapd
# PYTHON_BIN 填写同一虚拟环境 bin/python，令牌仍填写 TAPD_API_TOKEN
TAPD_API_BASE_URL="https://api.tapd.cn"
TAPD_BASE_URL="https://www.tapd.cn"
